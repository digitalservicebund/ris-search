{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "jsdoc": true,
  "sortTailwindcss": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": ["src/public/openapi.json", "src/types/api-generated.d.ts"]
}
