  <xs:element name="akomaNtoso">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="act" type="regelungstext" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="regelungstext" mixed="false">
    <xs:annotation>
      <xs:documentation
      >Die Klasse "regelungstext" bildet ein eigenständiges Teildokument eines Rechtsetzungsdokuments in der Verkündungsfassung in Form eines separaten XML-Dokuments, das durch die Klasse "rechtsetzungsdokument" referenziert und in dieser eingebunden wird.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="meta" type="metadatenVollstaendig" />
      <xs:group ref="regelungstextEinleitung" />
      <xs:element name="body" type="regelungstextHauptteil" />
      <xs:element
        name="conclusions"
        type="regelungstextSchluss"
        minOccurs="0"
      />
      <xs:element name="attachments" type="anlagencontainer" minOccurs="0" />
    </xs:sequence>
    <xs:attribute
      name="name"
      use="required"
      type="nameLiterals.regelungstext"
    />
  </xs:complexType>
