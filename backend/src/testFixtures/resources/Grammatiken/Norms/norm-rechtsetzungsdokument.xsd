  <xs:import
    namespace="http://www.w3.org/XML/1998/namespace"
    schemaLocation="./akn/xml.xsd"
  />
  <xs:include schemaLocation="norm-baukasten.xsd" />
  <xs:element name="akomaNtoso">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="documentCollection" type="rechtsetzungsdokument" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="rechtsetzungsdokument" mixed="false">
    <xs:annotation>
      <xs:documentation
      >Die Klasse "rechtsetzungsdokument" wird benutzt, um den Inhalt eines Rechtsetzungsdokuments in XML abzubilden. Auf Basis der Klasse "rechtsetzungsdokument" wird ein XML-Dokument erzeugt, worin durch Referenzierung die verschiedenen Bestandteile eines Rechtsetzungsdokuments eingebunden sind, die wiederum als separate XML-Dokumente angelegt werden. Auf Ebene des Schemas werden keine spezifischen Arten von Rechtsetzungsdokumenten unterschieden, da diese strukturell identisch aufgebaut sind. Die Darstellung spezifischer Rechtsetzungsdokumente erfolgt ausschließlich durch die Zuordnung von @name-Attributen.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="meta" type="metadatenMinimal" />
      <xs:element name="collectionBody" type="rechtsetzungsdokumentHauptteil" />
    </xs:sequence>
    <xs:attribute
      name="name"
      use="required"
      type="nameLiterals.rechtsetzungsdokument"
    />
  </xs:complexType>
  <xs:complexType name="rechtsetzungsdokumentHauptteil" mixed="false">
    <xs:annotation>
      <xs:documentation
      >Die Klasse "rechtsetzungsdokumentHauptteil" wird benutzt, um die einzelnen Bestandteile eines Rechtsetzungsdokuments (die einzelnen XML-Dateien) zu referenzieren.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="component" type="teildokument" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute
      name="eId"
      use="required"
      type="eIdLiterals.rechtsetzungsdokumentHauptteil"
    />
    <xs:attribute name="GUID" use="required" type="GUIDLiterals" />
    <xs:attribute ref="xml:id" use="optional" />
  </xs:complexType>
</xs:schema>
