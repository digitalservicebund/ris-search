      "member": "hydra:member",
      "view": "hydra:view",
      "first": {
        "@id": "hydra:first",
        "@type": "@id"
      },
      "previous": {
        "@id": "hydra:previous",
        "@type": "@id"
      },
      "next": {
        "@id": "hydra:next",
