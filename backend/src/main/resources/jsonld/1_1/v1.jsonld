      "Literature": {
        "@id": "ris:Literature",
        "@context": {
          "yearsOfPublication": "ris:yearsOfPublication",
          "documentTypes": "ris:documentTypes",
          "dependentReferences": "ris:dependentReferences",
          "independentReferences": "ris:independentReferences",
          "normReferences": "ris:normReferences",
