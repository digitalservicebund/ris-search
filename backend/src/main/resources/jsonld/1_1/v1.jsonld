          "headnote": "ris:headnote",
          "otherHeadnote": "ris:otherHeadnote",
          "otherLongText": "ris:otherLongText",
          "tenor": "ris:tenor",
          "decisionDate": "ris:decisionDate",
          "fileNumbers": "ris:fileNumber",
          "courtType": "ris:courtType",
          "location": "schema:location",
          "documentType": "ris:documentType",
          "outline": "ris:outline",
