      "name": "schema:name",
      "LegislationObject": "schema:LegislationObject",
      "PublicationIssue": "schema:PublicationIssue",
      "MediaObject": "schema:MediaObject",
      "documentNumber": "schema:identifier",
      "Legislation": {
        "@id": "schema:Legislation",
        "@context": {
          "eId": "ris:eId",
