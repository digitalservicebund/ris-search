{
  "type": "module",
  "scripts": {
    "audit:licences": "bash -c 'license-checker --production --excludePrivatePackages --onlyAllow \"$(./parse-allowed-licences.sh)\" --csv --out ./api-docs-licence-report.csv'",
    "build": "vitepress build",
    "dev": "vitepress dev",
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "lint": "oxlint --fix --no-error-on-unmatched-pattern",
    "preview": "vitepress preview",
    "style:check": "oxfmt --check && oxlint --max-warnings=0",
    "style:fix": "pnpm fmt && pnpm lint",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vitepress": "2.0.0-alpha.20",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@lizenz/checker": "0.0.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "warn"
    }
  }
}
