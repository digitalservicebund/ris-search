{
  "type": "module",
  "scripts": {
    "build": "vitepress build",
    "dev": "vitepress dev",
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "lint": "oxlint --fix --no-error-on-unmatched-pattern",
    "preview": "vitepress preview",
    "style:check": "oxfmt --check && oxlint --max-warnings=0",
    "style:fix": "pnpm fmt && pnpm lint",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "vitepress": "2.0.0-alpha.20",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "warn"
    }
  }
}
