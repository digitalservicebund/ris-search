{
  "type": "module",
  "scripts": {
    "build": "vitepress build",
    "dev": "vitepress dev",
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "lint": "oxlint --fix --no-error-on-unmatched-pattern",
    "preview": "vitepress preview",
    "style:check": "oxfmt --check && oxlint --max-warnings=0",
    "style:fix": "pnpm fmt && pnpm lint",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@digitalservicebund/ris-ui": "4.7.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "vitepress": "1.6.4",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.6.0",
      "onFail": "warn"
    }
  }
}
